{
  "name": "jri-mbse-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JRI MBSE 網頁工具：以 SysML v2 建模，依 NASA-HDBK-1009A 與 AEAS 工程指導原則",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "test": "node --test server/*.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.4",
    "@openmbee/opensysml": "0.11.0",
    "@xyflow/react": "12.3.6",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "jszip": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
