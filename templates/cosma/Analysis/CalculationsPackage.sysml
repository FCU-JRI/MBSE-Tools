/* CoSMA 範本（第 C 期，F-86）：套件結構照 Airbus Apollo 11 參考模型，內容是合成的示範，不是真實設計參數。 */
package CalculationsPackage {
    private import ScalarValues::*;
    private import ISQ::*;
    private import SI::*;
    private import ModelingMetadata::*;
    private import CoSMAPackage::*;
    private import JRIAddonPackage::*;

    calc def ThrustToWeight {
        in thrust : ISQ::ForceValue;
        in weight : ISQ::ForceValue;
        return ratio : Real = thrust / weight;
    }
}
